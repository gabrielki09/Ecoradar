// Schema do banco de dados do EcoRadar
// Documentação: https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}



model Usuario {
  id           String   @id @default(uuid())
  nome         String
  email        String   @unique
  senhaHash    String
  perfil       String
  cpfCnpj      String?
  endereco     String?
  telefone     String?
  criadoEm     DateTime @default(now())

  pontosColeta      PontoColeta[]       @relation("ColetorPontos")
  solicitacoes      Solicitacao[]       @relation("UsuarioSolicitacoes")
  pontosAcumulados  PontosUsuario?
  resgates          Resgate[]

  @@map("usuarios")
}

model CategoriaResiduo {
  id    String @id @default(uuid())
  nome  String @unique

  pontos        PontoCategoria[]
  solicitacoes  Solicitacao[]

  @@map("categorias_residuo")
}

model PontoColeta {
  id         String   @id @default(uuid())
  nome       String
  endereco   String
  bairro     String?
  horario    String?
  contato    String?
  ativo      Boolean  @default(true)
  coletorId  String
  coletor    Usuario  @relation("ColetorPontos", fields: [coletorId], references: [id])
  criadoEm   DateTime @default(now())

  categorias PontoCategoria[]

  @@map("pontos_coleta")
}

// Tabela de associação N:N entre pontos e categorias aceitas
model PontoCategoria {
  pontoId      String
  categoriaId  String
  ponto        PontoColeta       @relation(fields: [pontoId], references: [id], onDelete: Cascade)
  categoria    CategoriaResiduo  @relation(fields: [categoriaId], references: [id])

  @@id([pontoId, categoriaId])
  @@map("ponto_categorias")
}

model Solicitacao {
  id                String             @id @default(uuid())
  usuarioId         String
  usuario           Usuario            @relation("UsuarioSolicitacoes", fields: [usuarioId], references: [id])
  categoriaId       String
  categoria         CategoriaResiduo   @relation(fields: [categoriaId], references: [id])
  quantidade        Float
  unidade           String
  enderecoRetirada  String
  dataPreferencial  DateTime
  periodo           String
  observacoes       String?
  status            String  @default("PENDENTE")
  criadoEm          DateTime           @default(now())
  atualizadoEm      DateTime           @updatedAt

  @@map("solicitacoes_coleta")
}

model PontosUsuario {
  usuarioId  String  @id
  usuario    Usuario @relation(fields: [usuarioId], references: [id])
  total      Int     @default(0)

  @@map("pontos_usuario")
}

model Recompensa {
  id                 String    @id @default(uuid())
  nome               String
  pontosNecessarios  Int
  resgates           Resgate[]

  @@map("recompensas")
}

model Resgate {
  id            String      @id @default(uuid())
  usuarioId     String
  usuario       Usuario     @relation(fields: [usuarioId], references: [id])
  recompensaId  String
  recompensa    Recompensa  @relation(fields: [recompensaId], references: [id])
  dataResgate   DateTime    @default(now())

  @@map("resgates")
}
