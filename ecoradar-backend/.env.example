# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA faça commit do arquivo ".env" (ele já está no .gitignore).

# Conexão com o PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/ecoradar?schema=public"

# Porta da API
PORT=3333

# Segredo usado para assinar os tokens JWT (gere uma string aleatória longa)
JWT_SECRET="troque-por-um-segredo-forte-aqui"
JWT_EXPIRES_IN="7d"

# Origem permitida para o frontend (CORS)
FRONTEND_URL="http://localhost:5500"
